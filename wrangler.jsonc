{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pch-news",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-24",
  "triggers": { "crons": ["*/5 * * * *"] },
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "assets_navigation_has_no_effect"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/manus-storage/*",
      "/legacy-image/*",
      "/healthz",
      "/admin",
      "/admin/*",
      "/painel-editorial",
      "/painel-editorial/*",
      "/eventos",
      "/eventos/*",
      "/login",
      "/perfil",
      "/404",
      "/materia/*",
      "/colunista/*",
      "/convite/*"
    ]
  }
}
